# Copy to clouddroid.env and edit. Never commit the real file.

# Shared secret the phone sends as "Authorization: Bearer ...". At least 16 random characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CLOUDDROID_TOKEN=change-me-to-a-long-random-string

# Encrypts stored TeraBox sessions in the database:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLOUDDROID_SECRET_KEY=

CLOUDDROID_DATA_DIR=/var/lib/clouddroid
DATABASE_URL=postgresql://clouddroid:clouddroid@127.0.0.1:5432/clouddroid

# Android SDK tools (see provisioning/install_android_sdk.sh)
ADB_PATH=/opt/android-sdk/platform-tools/adb
EMULATOR_PATH=/opt/android-sdk/emulator/emulator
AVDMANAGER_PATH=/opt/android-sdk/cmdline-tools/latest/bin/avdmanager
AAPT2_PATH=/opt/android-sdk/build-tools/35.0.0/aapt2

# Remote device allocation
AVD_NAME=clouddroid
SYSTEM_IMAGE=system-images;android-34;google_apis;x86_64
DEVICE_CPU_CORES=4
DEVICE_RAM_MB=6144
DEVICE_DISK_GB=32
# swiftshader_indirect = software rendering (works anywhere, slow). Use "host" on a machine with a GPU.
EMULATOR_GPU=swiftshader_indirect

# WebRTC. A TURN server is needed for phones behind strict NATs / carrier networks.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USER=
TURN_PASSWORD=

SESSION_IDLE_SECONDS=900
